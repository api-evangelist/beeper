{
  "opencollection": "1.0.0",
  "info": {
    "name": "Beeper Desktop Accounts API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Chat Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:23373/v1/accounts",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Chat Accounts connected to this Beeper Desktop instance, including bridge metadata and network identity."
        }
      ]
    }
  ],
  "bundled": true
}